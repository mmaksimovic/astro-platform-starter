# Environment Variables Configuration
# Copy this file to .env and fill in your values

# ==============================================================================
# ANALYTICS
# ==============================================================================

# PostHog API Key (Optional)
# Used for product analytics and user behavior tracking
# Only loaded in production builds for privacy
# Get your key from: https://posthog.com/
# Example: phc_1234567890abcdefghijklmnopqrstuvwxyz
PUBLIC_POSTHOG_KEY=

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================

# Disable File Uploads (Optional)
# Set to 'true' to disable blob upload functionality
# Useful for demo environments or read-only deployments
# Default: false
# Example: true
PUBLIC_DISABLE_UPLOADS=

# ==============================================================================
# NETLIFY PLATFORM
# ==============================================================================

# Netlify Deploy Context (Automatic)
# Automatically set by Netlify during builds
# Possible values: production, deploy-preview, branch-deploy, dev
# You typically don't need to set this manually
# Example: production
CONTEXT=
